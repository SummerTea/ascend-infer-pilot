# === 只读参考底座（子目录独立 .git，不跟踪其内部代码，仅保留 .gitkeep）===
#     注：待优化的目标工程源码不在 repos/，而在 workspace/<scenario-id>/source/（每场景一份，整目录忽略）
/repos/refs/*
!/repos/refs/.gitkeep

# === 临时/工作区 ===
# 工作区：源码/优化后/台账，不入版本控制
/workspace/

# === 远端同步的第三方技能目录（仅保留 README 说明）===
/.agents/skills/external/*
!/.agents/skills/external/README.md

# === 技能同步缓存 ===
/.cache/

# === 临时 profiling / 中间产物 ===
/msprof_out/
*.prof
*.profiling
profiling_data/
*.tmp

# === 通用 ===
.DS_Store
__pycache__/
*.pyc
.venv/
.codegraph/
*.log

# === 本机环境说明（不入库）===
AGENTS.md.local
