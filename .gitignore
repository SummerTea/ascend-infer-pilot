# === 只读参考底座（子目录独立 .git，不跟踪其内部代码，仅保留 .gitkeep）===
#     注：待优化的目标工程源码不在 repos/，而在 workspace/<scenario-id>/source/（每场景一份，整目录忽略）
/repos/refs/*
!/repos/refs/.gitkeep

# === 临时/工作区 ===
# 工作区：源码/优化后/台账，不入版本控制
/workspace/

# === 技能目录（所有技能入库，忽略内部同步标记缓存）===
.agents/skills/.origins/

# === 技能同步缓存 ===
/.cache/

# === 临时 profiling / 中间产物 ===
/msprof_out/
*.prof
*.profiling
profiling_data/
*.tmp

# === 通用 ===
.DS_Store
__pycache__/
*.pyc
.venv/
.codegraph/
*.log

# === deepwork 会话状态（本地，不入库；.ignore 反向放行给 OpenCode 读取）===
.slim/deepwork/
