  "graph_builder_ops": [
    "LayerNormParam", "ElewiseParam", "LinearParam", "SoftmaxParam",
    "SelfAttentionParam", "RopeParam", "SplitParam",
    "GatherParam", "ActivationParam", "RmsNormParam", "AllGatherParam",
    "AsStridedParam", "CumsumParam", "DynamicNTKParam", "MultinomialParam",
