    "ActivationParam": { "init_style": "preserve" },
    "GatingParam": { "init_style": "preserve" },
    "LinearSparseParam": { "init_style": "preserve" }
  },

  "opaque_pointer_types": ["HcclComm"],

  "golden_mappings": {
    "LayerNormParam": { "category": "torch_builtin", "torch_ref": "torch.nn.LayerNorm", "inputs": ["x", "gamma", "beta"] },
    "SoftmaxParam": { "category": "torch_builtin", "torch_ref": "torch.nn.Softmax", "inputs": ["x"], "dim_from": "axes" },
    "RmsNormParam": { "category": "torch_compose", "torch_ref": "rms_norm_compose", "inputs": ["x", "gamma"] },
    "SplitParam": { "category": "torch_builtin", "torch_ref": "torch.chunk", "inputs": ["x"] },
    "ConcatParam": { "category": "torch_builtin", "torch_ref": "torch.cat", "inputs": ["tensors"] },
    "GatherParam": { "category": "torch_builtin", "torch_ref": "torch.gather", "inputs": ["x", "index"] },
    "ActivationParam": { "category": "torch_builtin", "torch_ref": "torch.nn.functional", "type_mapping": "activation_type" },
    "TransposeParam": { "category": "torch_builtin", "torch_ref": "torch.permute", "inputs": ["x"] },
    "ElewiseParam": { "category": "torch_builtin", "torch_ref": "torch", "type_mapping": "elewise_type" },
    "LinearParam": { "category": "torch_compose", "torch_ref": "F.linear", "inputs": ["x", "weight", "bias"] },
    "AllGatherParam": { "category": "comm_skip" },
    "AllReduceParam": { "category": "comm_skip" },
    "SelfAttentionParam": { "category": "skip_npu" },
    "IndexAddParam": { "category": "torch_compose", "torch_ref": "torch.index_add_", "inputs": ["var", "indices", "updates", "alpha"] },
    "WhereParam": { "category": "torch_compose", "torch_ref": "torch.where", "inputs": ["cond", "x", "y"] }
  }
}
