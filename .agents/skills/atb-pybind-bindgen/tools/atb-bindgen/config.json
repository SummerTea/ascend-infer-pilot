  },

  "namespace_enums": [
    "InputLayout", "QuantType", "DynamicQuantType", "ActivationType", "CommMode"
  ],

  "name_overrides": {},

  "field_overrides": {
    "SoftmaxParam.axes": { "binding": "svector_property_only" },
    "AsStridedParam.size": { "binding": "svector_property_only" },
    "AsStridedParam.stride": { "binding": "svector_property_only" },
    "AsStridedParam.offset": { "binding": "svector_property_only" }
  },

  "init_overrides": {
    "AsStridedParam": { "init_style": "svector_lambda", "svector_field": "size" },
    "SoftmaxParam": { "init_style": "svector_lambda", "svector_field": "axes" },
    "LayerNormParam": { "init_style": "preserve" },
    "ElewiseParam": { "init_style": "preserve" },
    "LinearParam": { "init_style": "preserve" },
    "SelfAttentionParam": { "init_style": "preserve" },
    "PagedAttentionParam": { "init_style": "preserve" },
    "RmsNormParam": { "init_style": "preserve" },
    "AllGatherParam": { "init_style": "preserve" },
    "AllReduceParam": { "init_style": "preserve" },
